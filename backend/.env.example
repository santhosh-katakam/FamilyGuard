DATABASE_URL=jdbc:postgresql://localhost:5432/familyguard
DATABASE_USER=familyguard
DATABASE_PASSWORD=CHANGE_ME
ADMIN_EMAIL=parent@example.com
ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_14_RANDOM_CHARACTERS
# Generate two different base64-encoded 32-byte random values. No defaults in production.
JWT_SECRET=REPLACE_WITH_BASE64_RANDOM_32_BYTES
DATA_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_BASE64_RANDOM_32_BYTES
FRONTEND_ORIGIN=http://localhost:5173
SECURE_COOKIES=false
OFFLINE_MINUTES=45
